{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(pnpm run *)",
            "Bash(pnpm install)",
            "Bash(pnpm dlx *)",
            "Bash(git status)",
            "Bash(git diff *)",
            "Bash(git log *)",
            "Bash(git show *)",
            "Bash(git branch *)",
            "Bash(pac code *)",
            "Read(**)",
            "Grep(**)",
            "Glob(**)"
        ],
        "ask": [
            "Bash(pac auth *)",
            "Bash(pac env *)"
        ],
        "deny": [
            "Bash(rm -rf *)",
            "Bash(git push --force *)",
            "Bash(git reset --hard *)"
        ],
        "defaultMode": "acceptEdits"
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "pnpm exec prettier --write --ignore-unknown \"$CLAUDE_FILE_PATHS\" 2>/dev/null || true"
                    }
                ]
            }
        ]
    }
}
