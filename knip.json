{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": ["src/app/main.tsx"],
    "project": ["src/**/*.{ts,tsx}"],
    "ignore": ["src/shared/components/ui/**"],
    "ignoreDependencies": ["date-fns", "zod"],
    "ignoreExportsUsedInFile": true,
    "rules": {
        "exports": "off",
        "types": "off",
        "nsExports": "off",
        "nsTypes": "off",
        "enumMembers": "off"
    }
}
