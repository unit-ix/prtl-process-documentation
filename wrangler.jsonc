{
    // Cloudflare-Workers-Konfiguration (Static Assets, reine SPA).
    // Beim Projektstart: <projekt-slug> ersetzen (nur Kleinbuchstaben, Ziffern,
    // Bindestriche — Cloudflare lehnt Punkte/Unterstriche/Großbuchstaben ab).
    // Solange der Platzhalter drinsteht, schlägt jeder Deploy mit einer klaren
    // wrangler-Fehlermeldung fehl — es entsteht kein Müll-Worker.
    // Deployt wird immer mit --env (siehe .github/workflows/deploy.yml), sodass
    // zwei getrennte Worker entstehen:
    //   --env production -> <projekt-slug>        (Prod)
    //   --env test       -> test-<projekt-slug>   (Test + PR-Previews)
    "name": "<projekt-slug>",
    "compatibility_date": "2026-07-08",
    "observability": { "enabled": true },

    // workers.dev-Route aktiv halten — sonst antwortet die *.workers.dev-URL mit
    // Cloudflare-Error 1042. Pro Environment nochmals gesetzt, da mit --env
    // deployt wird und Wrangler nicht alle Top-Level-Keys vererbt.
    "workers_dev": true,

    // Reine SPA: KEIN `main` (kein Server-Code). Der Worker liefert nur die
    // statischen Assets aus `dist/` aus. Assets sind zusätzlich je Environment
    // gesetzt, damit der Deploy unabhängig von Wrangler-Vererbungsregeln
    // garantiert funktioniert.
    "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
    },

    "env": {
        "production": {
            "name": "<projekt-slug>",
            "workers_dev": true,
            "assets": {
                "directory": "./dist",
                "not_found_handling": "single-page-application"
            }
            // Custom Domain (optional): Zone muss im selben Cloudflare-Konto
            // liegen -> Cloudflare legt den DNS-Eintrag automatisch an.
            // "routes": [{ "pattern": "<projekt-slug>.example.de", "custom_domain": true }]
        },
        "test": {
            "name": "test-<projekt-slug>",
            "workers_dev": true,
            "assets": {
                "directory": "./dist",
                "not_found_handling": "single-page-application"
            }
            // "routes": [{ "pattern": "test-<projekt-slug>.example.de", "custom_domain": true }]
        }
    }
}
