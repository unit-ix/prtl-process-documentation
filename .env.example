# Die EINE .env des Repos. Kopieren nach .env (gitignored). Hier steht nur, was allein auf diesem
# Rechner existiert; alles Übrige steht in .unitix/project.json bzw. als App Setting in Azure.
# Eine .env in apps/* ist verboten — `pnpm verify` blockt sie. Tabelle: docs/azure-runbook.md, 3b.

# Dein UPN im Mandanten, nicht die Managed Identity. Für `pnpm dev:full` und Migrationen.
PGUSER=

# Portal → Static Web App → Overview → Manage deployment token. Suffix ist Pflicht.
SWA_DEPLOYMENT_TOKEN_DEV=
SWA_DEPLOYMENT_TOKEN_PROD=

# Nur für `pnpm db:grant`. Name der Web App + Object ID aus Portal → Web App → Identity.
API_IDENTITY_NAME=
API_IDENTITY_OBJECT_ID=

# Nur mit E-Mail-Versand: das einzige Secret des Repos. Nie in .unitix/project.json (committet), nie mit VITE_-Präfix.
MAIL_CONNECTION_STRING=
