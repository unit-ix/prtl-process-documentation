# Root-.env — nur für lokale Deploy-Befehle, NICHT für die SPA.
# Kopieren nach .env (gitignored) und Werte einsetzen. `pnpm deploy:swa` lädt die Datei über
# Nodes --env-file-if-exists; ohne .env funktioniert weiterhin `export SWA_DEPLOYMENT_TOKEN=…`.
#
# Serverseitige Variablen der Node-API stehen NICHT hier, sondern in apps/api/.env
# (siehe apps/api/.env.example).

# Static Web App → Overview → Manage deployment token
SWA_DEPLOYMENT_TOKEN=
