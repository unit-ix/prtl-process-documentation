# Die EINE .env des Repos. Kopieren nach .env (gitignored) und Werte einsetzen.
# Hier steht nur, was allein auf diesem Rechner existiert und nie ausgeliefert wird — eine .env in
# einem apps/*-Package ist verboten (pnpm verify blockt sie).
#
# Alles Übrige steht in .unitix/project.json; in Azure sind es gleichnamige App Settings.
# Tabelle: docs/azure-runbook.md, Schritt 3b. Umgebungs-Modell: docs/environments.md.

# Dein UPN im Mandanten — nicht die Managed Identity. Migrationen von hier aus laufen unter deiner
# az-login-Identität; in Azure ist PGUSER die Managed Identity (`pg.user`).
# Nötig für `pnpm dev:full` und jeden Deploy, der Migrationen einspielt.
PGUSER=

# Deployment-Token der beiden Static Web Apps, je Umgebung.
# Portal → Static Web App → Overview → Manage deployment token.
#
# Der Name trägt die Umgebung, und ein unsuffixierter SWA_DEPLOYMENT_TOKEN wird bewusst NICHT
# akzeptiert: bei zwei Umgebungen ist "welche SWA war das eigentlich" die falsche Frage, um sie
# beim Prod-Deploy zu stellen.
SWA_DEPLOYMENT_TOKEN_DEV=
SWA_DEPLOYMENT_TOKEN_PROD=

# Managed Identity der Ziel-Web-App, nur für `pnpm db:grant`. Name = Name der Web App,
# Object ID aus Portal → Web App → Identity. Ohne Suffix: vor dem Grant gegen die zweite
# Umgebung deren Werte eintragen. docs/azure-runbook.md, Schritt 4.
API_IDENTITY_NAME=
API_IDENTITY_OBJECT_ID=
