// Vorlage — Endung .example entfernen zum Aktivieren. Konzept: docs/blob-storage.md.
//
// Kein Pfad-Segment kommt vom Client, und `upload()` liefert eine Id statt einer URL: eine
// dauerhafte Adresse wäre die Pfad-Spalte, die Invariante 2 gerade ausschliesst.

export interface FileMeta {
    readonly id: string;
    readonly fileName: string;
    readonly contentType: string;
    readonly sizeBytes: number;
    readonly createdOn: string;
}

export interface FileStore {
    list(contactId: string): Promise<FileMeta[]>;

    /** Legt Blob und Zeile an. Rückgabe: die Id der neuen Zeile. */
    upload(contactId: string, file: File): Promise<string>;

    /**
     * Eine Adresse, unter der DIESE Datei jetzt geladen werden kann — kurzlebig, pro Abruf neu.
     * Nicht cachen und nicht speichern: der Wert ist eine Erlaubnis auf Zeit.
     */
    downloadUrl(id: string): Promise<string>;

    remove(id: string): Promise<void>;
}
