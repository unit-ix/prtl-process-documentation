# apps/api — Env-Vertrag der Node-API. Kopieren nach apps/api/.env (gitignored), validiert beim
# Start von src/env.ts. Geladen über Nodes `--env-file-if-exists` (siehe package.json) — in Azure
# sind die App Settings selbst schon Umgebungsvariablen, dort greift das Laden ins Leere.

# --- Datenbank -----------------------------------------------------------------------------
# Immer passwortlos: lokal die `az login`-Sitzung, in Azure die Managed Identity. Es gibt bewusst
# keinen lokalen Postgres — lokal läuft es gegen den DEV-Server und braucht dort eine
# Firewall-Regel für deine IP (docs/azure-setup.md, "Lokal entwickeln").
PGHOST=<dev-server>.postgres.database.azure.com
PGDATABASE=app
PGUSER=<dein-upn>   # in Azure: der Name der Managed Identity
# PGPORT=5432

# --- Entra ID ------------------------------------------------------------------------------
# Beide entstehen bei der App-Registrierung — docs/azure-setup.md, Schritt 1.
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=

# --- Transport -----------------------------------------------------------------------------
PORT=3000

# Nur die SWA-Origin, kein Wildcard. Lokal leer lassen — vite proxied /api same-origin.
ALLOWED_ORIGIN=

# RATE_LIMIT_MAX=200      # pro angemeldetem Nutzer und Minute
# BODY_LIMIT_BYTES=65536
